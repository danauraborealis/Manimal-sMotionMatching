<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>$(ModAuthor).$(ModName)</AssemblyName>
    <RootNamespace>Manimal.MotionMatching</RootNamespace>
    <Version>$(ModVersion)</Version>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <ManagedPath>$(SptRoot)\EscapeFromTarkov_Data\Managed</ManagedPath>
    <ToolkitPath>$(SptRoot)\BepInEx\plugins\UnityToolkit</ToolkitPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ManagedPath)\UnityEngine*.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedPath)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Comfort" HintPath="$(ManagedPath)\Comfort.dll" Private="false" />
    <Reference Include="AnimationSystem.Types" HintPath="$(ManagedPath)\AnimationSystem.Types.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedPath)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(SptRoot)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(SptRoot)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="spt-reflection" HintPath="$(SptRoot)\BepInEx\plugins\spt\spt-reflection.dll" Private="false" />
    <Reference Include="ZLinq" HintPath="$(ToolkitPath)\ZLinq.dll" Private="false" />
  </ItemGroup>
  <Target Name="GenerateModInfo" BeforeTargets="CoreCompile">
    <ItemGroup>
      <ModInfoLines Include="namespace Manimal.MotionMatching { internal static class ModInfo {" />
      <ModInfoLines Include="public const string Guid = &quot;$(ModGuid)&quot;%3B" />
      <ModInfoLines Include="public const string Name = &quot;$(ModDisplayName)&quot;%3B" />
      <ModInfoLines Include="public const string Version = &quot;$(ModVersion)&quot;%3B" />
      <ModInfoLines Include="public const string Author = &quot;$(ModAuthor)&quot;%3B" />
      <ModInfoLines Include="public const string RepositoryUrl = &quot;$(ModRepositoryUrl)&quot;%3B }}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)ModInfo.g.cs" Lines="@(ModInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)ModInfo.g.cs" /></ItemGroup>
  </Target>
</Project>
